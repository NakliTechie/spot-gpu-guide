<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd agent for the relaunch loop itself (templates/relaunch.sh), not only the supervisor: a reboot must bring
     the launcher back too, or a preempted VM stays down until someone logs in.
     The loop's deliberate exits return 0, so KeepAlive{SuccessfulExit:false} restarts only crashes.
     Install: fill placeholders, copy to ~/Library/LaunchAgents/<label>.plist, then
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/<label>.plist
     Inspect: launchctl print gui/$(id -u)/<label> | grep -E 'state|pid'   Remove: launchctl bootout gui/$(id -u)/<label> -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>LABEL_PLACEHOLDER</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>RELAUNCH_SH_PLACEHOLDER</string><string>JOB_ENV_PLACEHOLDER</string></array>
  <key>WorkingDirectory</key><string>PROJECT_DIR_PLACEHOLDER</string>
  <!-- PATH must reach gcloud: add its bin directory if it lives elsewhere (e.g. HOME/google-cloud-sdk/bin). -->
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string><key>HOME</key><string>HOME_PLACEHOLDER</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>60</integer>
  <key>StandardOutPath</key><string>LOG_PATH_PLACEHOLDER</string>
  <key>StandardErrorPath</key><string>LOG_PATH_PLACEHOLDER</string>
</dict></plist>

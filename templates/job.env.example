# job.env — config for templates/relaunch.sh (one file per job). Copy, fill every <...>, keep next to your logs.
JOB_NAME=<vm-name>                        # one VM at a time under this exact name
JOB_PROJECT=<gcp-project-id>
JOB_ZONES="<zone-a> <zone-b>"             # rotated on no-capacity; all need spot GPU quota
JOB_MACHINE=<machine-type>                # g4-standard-48 (RTX PRO 6000) · a2-ultragpu-1g (A100-80)
JOB_DISK_TYPE=<disk-type>                 # hyperdisk-balanced on g4 (pd-balanced is rejected) · pd-balanced on a2
JOB_DISK_GB=200
JOB_IMAGE_FAMILY=<dl-image-family>        # e.g. common-cu129-ubuntu-2204-nvidia-580 (Blackwell needs driver ≥ 570)
JOB_IMAGE_PROJECT=deeplearning-platform-release
JOB_LABEL=<project-label>=true            # cost allocation + IAM destructive gate
JOB_STARTUP=<path/to/batch_job.sh>        # filled copy of templates/batch_job.sh
JOB_MAX_RUN=240m                          # per-life cap (--max-run-duration); the VM deletes itself at the cap
JOB_RATE=<usd-per-hour>                   # from the billing catalog, with the read date in a comment
JOB_CAP_USD=<campaign-cap>                # finished lives (operations log × rate) + the running life's elapsed time
JOB_MAX_LIVES=6
JOB_DONE_CMD="gcloud storage ls gs://<bucket>/<job-name>/campaign-1/DONE"   # exits 0 when the job is finished
JOB_ERROR_CMD="gcloud storage ls gs://<bucket>/<job-name>/campaign-1/ERROR" # exits 0 on an explicit failure: stop, do not loop
JOB_OUT=<dir-for-pid-state-logs>
